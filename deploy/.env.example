# 复制为 .env 再编辑：cp .env.example .env

# 登录鉴权密钥；为空则服务端走 OPEN_MODE（仅本地开发用，测试服务必填）
LOGIN_SHARED_SECRET=replace-me-32+-bytes

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lastbastion
MYSQL_USER=lastbastion
MYSQL_PASSWORD=lastbastion

# 持久化方式：mysql / redis / file（默认 mysql）
STORE_KIND=mysql

# Nginx 暴露端口；HTTPS 需要在 ./nginx/certs 放 fullchain.pem + privkey.pem
EXPOSE_HTTP_PORT=80
EXPOSE_HTTPS_PORT=443

# 直接暴露给客户端的可选端口（生产建议删除）
EXPOSE_JSON_PORT=10100
EXPOSE_HEALTH_PORT=10199

# Nginx 装载的证书目录（默认 ./nginx/certs）
TLS_CERT_DIR=./nginx/certs
