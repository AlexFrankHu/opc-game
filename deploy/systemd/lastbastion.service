# 不想用 Docker 时的 systemd 部署方式
#
# 安装：
#   sudo cp deploy/systemd/lastbastion.service /etc/systemd/system/
#   sudo cp SourceCode/server/app/target/last-bastion-app-fat.jar /opt/lastbastion/last-bastion-app.jar
#   sudo cp -r assets/numeric /opt/lastbastion/numeric
#   sudo useradd -r -s /sbin/nologin lastbastion
#   sudo mkdir -p /var/lib/lastbastion/players && sudo chown -R lastbastion: /var/lib/lastbastion /opt/lastbastion
#   sudo cp deploy/systemd/lastbastion.env.example /etc/lastbastion.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now lastbastion

[Unit]
Description=Last Bastion ioGame + JSON gateway
After=network.target mysqld.service redis.service
Wants=mysqld.service

[Service]
Type=simple
User=lastbastion
Group=lastbastion
EnvironmentFile=/etc/lastbastion.env
WorkingDirectory=/opt/lastbastion
ExecStart=/usr/bin/java $JAVA_OPTS \
    -Dnumeric.dir=/opt/lastbastion/numeric \
    -Dstore.kind=${STORE_KIND} \
    -Dstore.root=/var/lib/lastbastion/players \
    -jar /opt/lastbastion/last-bastion-app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
