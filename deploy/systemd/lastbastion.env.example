# Copy to /etc/lastbastion.env

JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC

# 持久化方式：file / mysql / redis
STORE_KIND=mysql

# 启用 HMAC 鉴权；未配置则 OPEN_MODE
LOGIN_SHARED_SECRET=replace-me-32+-bytes

# MySQL（STORE_KIND=mysql 时必填）
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/lastbastion?useSSL=false&serverTimezone=UTC
MYSQL_USER=lastbastion
MYSQL_PASSWORD=lastbastion

# Redis（STORE_KIND=redis 或之后用作缓存）
REDIS_URI=redis://127.0.0.1:6379/0
