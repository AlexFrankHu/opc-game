<!-- 竞技场的匹配规则：第一、第二、第三个位置的匹配系数区间分别是:-->
<!-- 比如我现在的排名是1000，那么给我匹配的时候，
第一个位置的玩家等级区间就是 1000*0.5~1000*0.25，
第二个位置的玩家的等级区间就是 1000*0.95~1000*0.5，
第三个位置的区间下限是排名比我高一级的玩家，上限是1000*0.95
-->
<root>
      <data id="1" minRate="0.25" maxRate="0.5"/>
	  <data id="2" minRate="0.5" maxRate="0.95"/>
	  <data id="3" minRate="0.95" maxRate="1"/>
</root>